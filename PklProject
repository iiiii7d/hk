amends "pkl:Project"

dependencies {
  ["hk"] { 
    uri = "package://github.com/jdx/hk/releases/download/v" + read?("env:VERSION") + "/hk@" + read?("env:VERSION")
  }
}

package {
  name = "hk"
  authors { "7d <61975820+iiiii7d@users.noreply.github.com>" }
  version = read?("env:VERSION") ?? "0.0.1-SNAPSHOT"
  baseUri = "package://pkg.pkl-lang.org/github.com/iiiii7d/hk"
  packageZipUrl = "https://github.com/iiiii7d/hk/releases/download/v\(version)/\(name)@\(version).zip"
  sourceCode = "https://github.com/iiiii7d/hk"
  sourceCodeUrlScheme = "https://github.com/iiiii7d/hk/blob/\(version)/pkl%{path}#%{line}-%{endLine}"
}
