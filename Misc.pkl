import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

const zizmor_inner = Builtins.zizmor
const zizmor = new Config.Group {
    steps {
        ["zizmor_no_sarif"] = (zizmor_inner) {
            profiles = List("!sarif")
        }
        ["zizmor_sarif"] = (zizmor_inner) {
            profiles = List("sarif")
            check = (super.check) {
                command = (super.command) {
                    argv = super.argv + List("--format=sarif")
                }
            }
            fix = (super.check) {
                command = (super.command) {
                    argv = super.argv + List("--format=sarif")
                }
            }
            diagnostic_format = "sarif"
            diagnostic_tool = "zizmor"
        }
    }
}

const actionlint = Builtins.actionlint

const poutine_inner = new Config.Step {
    glob = Builtins.zizmor.glob
    check = "poutine analyze_local . --skip github_action_from_unverified_creator_used"
}
const poutine = new Config.Group {
    steps {
        ["poutine_no_sarif"] = (poutine_inner) {
            profiles = List("!sarif")
        }
        ["poutine_sarif"] = (poutine_inner) {
            profiles = List("sarif")
            check = super.check + " --format=sarif"
            diagnostic_format = "sarif"
            diagnostic_tool = "poutine"
        }
    }
}

const hadolint_inner = Builtins.hadolint
const hadolint = new Config.Group {
    steps {
        ["hadolint_no_sarif"] = (hadolint_inner) {
            profiles = List("!sarif")
        }
        ["hadolint_sarif"] = (hadolint_inner) {
            profiles = List("sarif")
            check = (super.check) {
                command = (super.command) {
                    argv = super.argv + List("--format=sarif")
                }
            }
            diagnostic_format = "sarif"
            diagnostic_tool = "hadolint"
        }
    }
}

const shellcheck = Builtins.shellcheck

