{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>iiiii7d/renovate-config:no-dev",
    ":pinAllExceptPeerDependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)PklProject$/"
      ],
      "matchStrings": [
        "local hkVersion = (?<currentValue>.+?)",
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "jdx/hk"
    }
  ]
}
