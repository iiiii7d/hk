import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

const format = (Builtins.prettier) {
    workspace_indicator = "package.json"
    check = "pnpm run format:check {{ workspace_files }}"
    check_list_files = null
    fix = "pnpm run format {{ workspace_files }}"
    dir = "{{ workspace }}"
}

const lint = (Builtins.eslint) {
    workspace_indicator = "package.json"
    check = "pnpm run lint {{ workspace_files }}"
    fix = "pnpm run lint:fix {{ workspace_files }}"
    dir = "{{ workspace }}"
}

const type_check = new Config.Step {
    workspace_indicator = "package.json"
    glob = Builtins.eslint.glob
    check = "pnpm run type-check"
    dir = "{{ workspace }}"
    diagnostic_format = "tsc"
}
