import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

const hatch_check_fmt = (Builtins.ruff_format) {
    workspace_indicator = "pyproject.toml"
    check = "cd {{ workspace }} && hatch check fmt -- --force-exclude {{ workspace_files }}"
    check_diff = "cd {{ workspace }} & hatch check fmt --fix -- --force-exclude --diff {{ workspace_files }}"
    fix = "cd {{ workspace }} && hatch check fmt --fix -- --force-exclude {{ workspace_files }}"
}

const hatch_check_code = (Builtins.ruff) {
    workspace_indicator = "pyproject.toml"
    check = "cd {{ workspace }} && hatch check code -- --force-exclude {{ workspace_files }}"
    fix = "cd {{ workspace }} && hatch check code --fix -- --force-exclude {{ workspace_files }}"
}

const hatch_check_types = new Config.Step {
    workspace_indicator = "pyproject.toml"
    types = Builtins.ruff.types
    check = "cd {{ workspace }} && hatch check types"
}

const function hatch_check_code_sarif(sarif_dir: String) = new Config.Step {
    workspace_indicator = "pyproject.toml"
    fix = hatch_check_code.fix.replaceAll("{{ workspace_files }}", "") + " --output-format=sarif > \(sarif_dir)/hatch-{{ workspace }}.sarif"
}
